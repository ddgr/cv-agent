# Anthropic API key, kept as a secret in Azure Container Apps
ANTHROPIC_API_KEY=
# Key the platform sends as "Authorization: Bearer <key>"
AGENT_API_KEY=
# Model used to answer
ANTHROPIC_MODEL=claude-sonnet-5-5
# Path of the single CV the agent answers from
CV_PATH=knowledge/cv.md
# Maximum tokens generated per answer
MAX_OUTPUT_TOKENS=2048
# Seconds before a provider call times out
REQUEST_TIMEOUT_S=30
